# Copier en `.env` à la racine, puis `docker compose up -d --build`.
# Toutes les clés sont optionnelles : sans elles, la démo fonctionne en mode simulé.

# --- Sécurité ---
JWT_SECRET=mindbenin-dev-secret-change-me
ADMIN_ACCESS_CODE=mindbenin-admin
# Code agent (lecture seule des dossiers, pas d'annulation ni d'audit) — vide = pas de rôle agent.
ADMIN_AGENT_CODE=

# --- URLs ---
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4001

# --- Paiement FedaPay ---
FEDAPAY_SECRET_KEY=
FEDAPAY_BASE_URL=https://sandbox-api.fedapay.com/v1
FEDAPAY_CALLBACK_URL=http://localhost:4001/payments/fedapay/callback
# Secret HMAC du webhook FedaPay (header `x-fedapay-signature`). Vide = signature non vérifiée.
FEDAPAY_WEBHOOK_SECRET=

# --- Pièces justificatives (MinIO / tout S3 compatible) ---
# Laisser vide pour écrire dans le volume local `mindbenin_storage`.
#   docker compose --profile minio up -d
S3_ENDPOINT=
# S3_ENDPOINT=http://minio:9000
S3_BUCKET=mindbenin
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Notifications (SMS / WhatsApp / webhook générique) ---
# Sans clé, chaque envoi est journalisé avec le statut SIMULE et le message est lisible dans l'app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
